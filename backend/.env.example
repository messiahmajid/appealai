DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appealai

# Required — get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini text fallback order. Lower-tier models are tried first to reduce free-tier throttling.
GEMINI_TEXT_MODELS=gemini-2.0-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# Optional (paid alternatives)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

LOG_LEVEL=INFO
